<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- Single source of truth for the package version. publish.yml reads this file. -->
    <Version>1.1.0</Version>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>Aleksandr Platonenkov</Authors>
    <Company>Aleksandr Platonenkov</Company>
    <Copyright>Copyright (c) 2026 Aleksandr Platonenkov</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Platonenkov/Telegram.OpenIdConnect.AspNetCore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Platonenkov/Telegram.OpenIdConnect.AspNetCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <PropertyGroup Label="Source Link and symbols">
    <!-- The .NET SDK ships SourceLink for GitHub in-box; no PackageReference needed. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
